#!/bin/sh
# wait-for-bind-addr <interface> <address> [timeout-seconds]
#
# Block until <address> is assigned to <interface>. Used as an ExecStartPre gate
# for Consul and Nomad.
#
# Both agents pin themselves to the Tailscale address: Consul via bind_addr /
# advertise_addr, Nomad via GetInterfaceIP in its advertise block. Neither can
# start before tailscaled has configured tailscale0, and tailscaled reaches
# systemd "ready" before the tailnet address is actually assigned -- so
# After=tailscaled.service on its own does not close the race.
#
# Managed by ansible (roles/resilience). Do not edit by hand.
set -u

iface=${1:?usage: wait-for-bind-addr <interface> <address> [timeout]}
addr=${2:?usage: wait-for-bind-addr <interface> <address> [timeout]}
timeout=${3:-120}

elapsed=0
while [ "$elapsed" -lt "$timeout" ]; do
	if ip -4 -o addr show dev "$iface" 2>/dev/null | grep -q " inet $addr/"; then
		exit 0
	fi
	elapsed=$((elapsed + 1))
	sleep 1
done

echo "wait-for-bind-addr: $addr did not appear on $iface within ${timeout}s" >&2
exit 1
