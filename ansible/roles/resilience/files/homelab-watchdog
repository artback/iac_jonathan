#!/bin/sh
# Periodic health probe for the homelab control plane.
#
# systemd's OnFailure= only fires when a unit reaches the "failed" state. The
# 2026-08-13 outage is a reminder that this is not enough on its own: Consul was
# dead for two days while every workload kept running, so nothing crashed
# loudly and nothing noticed. This probe asks the questions that actually
# matter -- is there a Consul leader, are services registered, does the public
# URL still answer -- and alerts on the answers.
#
# Alerts fire on transitions only (healthy -> unhealthy and back), so a lasting
# outage produces one message rather than one every interval.
#
# Managed by ansible (roles/resilience). Do not edit by hand.
set -u

# Deliberately not called ENV_FILE: this script execs homelab-alert, which
# reads its own credentials file, and a shared name would be inherited by the
# child -- pointing the alerter at a token-less file exactly when it is needed.
WATCHDOG_ENV_FILE=${WATCHDOG_ENV_FILE:-/etc/homelab-watchdog.env}
[ -r "$WATCHDOG_ENV_FILE" ] && . "$WATCHDOG_ENV_FILE"

CONSUL_ADDR=${CONSUL_ADDR:-http://127.0.0.1:8500}
WATCHED_UNITS=${WATCHED_UNITS:-consul nomad docker tailscaled}
IGNORED_CHECK_SERVICES=${IGNORED_CHECK_SERVICES:-}
PROBE_URL=${PROBE_URL:-}
STATE_FILE=${STATE_FILE:-/var/lib/homelab-watchdog/state}
HEARTBEAT_URL=${HEARTBEAT_URL:-}

problems=""

note() {
	problems="${problems}
• $1"
}

# 1. The units themselves.
for unit in $WATCHED_UNITS; do
	if ! systemctl is-active --quiet "$unit"; then
		note "$unit is $(systemctl is-active "$unit" 2>&1)"
	fi
done

# 2. Consul must have a leader. A running-but-leaderless agent still answers on
#    :8500 while every catalog write fails, which no is-active check would spot.
leader=$(curl -sf --max-time 5 "$CONSUL_ADDR/v1/status/leader" 2>/dev/null || true)
case "$leader" in
	'""' | '') note "consul has no leader" ;;
esac

# 3. Critical service checks, minus the ones known to be permanently wrong.
if [ -n "$leader" ] && [ "$leader" != '""' ]; then
	critical=$(curl -sf --max-time 5 "$CONSUL_ADDR/v1/health/state/critical" 2>/dev/null |
		tr '{' '\n' | sed -n 's/.*"ServiceName":"\([^"]*\)".*/\1/p' | sort -u)
	for svc in $critical; do
		[ -z "$svc" ] && continue
		ignored=0
		for skip in $IGNORED_CHECK_SERVICES; do
			[ "$svc" = "$skip" ] && ignored=1
		done
		[ "$ignored" -eq 0 ] && note "consul check critical: $svc"
	done
fi

# 4. Backup freshness. Between 2026-08-09 and 2026-08-15 the nightly pg_dumpall
#    did not run at all — Consul was down, so Nomad could not place the periodic
#    job — and nothing said so. That is the same silent-failure shape as the
#    outage itself, and it matters more here: this cluster has already lost a
#    database once, in June 2026, with no usable dump.
if [ -n "$BACKUP_DIR" ]; then
	newest=$(ls -t "$BACKUP_DIR"/*.sql.gz 2>/dev/null | head -1)
	if [ -z "$newest" ]; then
		note "no database backups found in $BACKUP_DIR"
	else
		age_h=$(( ( $(date +%s) - $(stat -c %Y "$newest") ) / 3600 ))
		size=$(stat -c %s "$newest")
		if [ "$age_h" -gt "${BACKUP_MAX_AGE_HOURS:-30}" ]; then
			note "newest database backup is ${age_h}h old ($(basename "$newest"))"
		fi
		# A dump that exists but is tiny is worse than none, because it looks fine.
		if [ "$size" -lt "${BACKUP_MIN_BYTES:-100000}" ]; then
			note "newest database backup is only ${size} bytes — suspiciously small"
		fi
	fi
fi

# 5. End-to-end probe of the public entry point.
if [ -n "$PROBE_URL" ]; then
	code=$(curl -s -o /dev/null -w '%{http_code}' --max-time 10 "$PROBE_URL" 2>/dev/null || echo 000)
	case "$code" in
		2* | 3*) ;;
		*) note "$PROBE_URL returned HTTP $code" ;;
	esac
fi

# Report only on a change of state.
mkdir -p "$(dirname "$STATE_FILE")"
previous=""
[ -r "$STATE_FILE" ] && previous=$(cat "$STATE_FILE")

if [ -n "$problems" ]; then
	current="unhealthy"
	message="🚨 <b>Homelab unhealthy</b> ($(hostname))${problems}"
else
	current="healthy"
	message="✅ <b>Homelab recovered</b> ($(hostname))"
fi

if [ "$current" != "$previous" ]; then
	# Say nothing on the very first run if all is well -- no news is not news.
	if [ -n "$previous" ] || [ "$current" = "unhealthy" ]; then
		/usr/local/sbin/homelab-alert "$message"
	fi
	printf '%s' "$current" >"$STATE_FILE"
fi

# --- External dead-man's switch ---------------------------------------------
#
# Everything above runs ON the Pi, so none of it can report the Pi being down:
# power cut, kernel panic or a dead tailscale0 all look exactly like silence,
# and silence is indistinguishable from "nothing is wrong". Only something off
# this machine can tell those apart.
#
# So the direction is inverted here. Instead of an outside service polling us
# -- which would need an inbound route into a tailnet-only host -- we ping out
# on every run, and the far end alerts when the pings stop. That needs no open
# port and no public exposure, and it fails safe: anything that stops this
# script also stops the heartbeat.
#
# Deliberately last: a heartbeat is a claim that the checks above ran and were
# read. Pinging earlier would keep the far end quiet while this script was
# dying halfway through, which is precisely the case it exists to catch.
#
# The /fail path is redundant with our own Telegram alert, on purpose: if the
# bot token is wrong or Telegram is unreachable, the far end is the only thing
# left that can still reach you.
if [ -n "$HEARTBEAT_URL" ]; then
	if [ "$current" = "healthy" ]; then
		beat="$HEARTBEAT_URL"
	else
		beat="${HEARTBEAT_URL%/}/fail"
	fi
	# Never fail the watchdog over the heartbeat: a flaky uplink must not turn
	# a healthy cluster into a unit failure.
	curl -sf -m 10 -o /dev/null --retry 2 "$beat" ||
		echo "homelab-watchdog: heartbeat ping failed" >&2
fi

[ "$current" = "healthy" ]
