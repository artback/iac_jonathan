<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.artback.pi-watchdog</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/sh</string>
    <string>/Users/jonathan/.config/homelab/pi-watchdog.sh</string>
  </array>
  <!-- Every 10 minutes. Paired with the transition-only logic in the script,
       a lasting outage is one message rather than six an hour. -->
  <key>StartInterval</key>
  <integer>600</integer>
  <!-- Fires once shortly after login/wake too, so closing the lid overnight
       and opening it in the morning surfaces an outage that started while the
       Mac was asleep. -->
  <key>RunAtLoad</key>
  <true/>
  <key>StandardErrorPath</key>
  <string>/tmp/pi-watchdog.err</string>
  <key>ProcessType</key>
  <string>Background</string>
</dict>
</plist>
