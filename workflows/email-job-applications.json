        {
            "parameters": {
                "mode": "runOnceForAllItems",
                "jsCode": "// RECONSTRUCTED PLACEHOLDER - the original code was lost with the database.\n// Original purpose (from logs): filter and normalize incoming email data\n// before categorization. Adjust to your needs.\nreturn items.map((item) => {\n  const j = item.json;\n  const subject = (j.subject || '').trim();\n  const text = (j.textPlain || j.textHtml || '').trim();\n  const from = j.from?.value?.[0]?.address || j.from || '';\n\n  // TODO: restore your original categorization logic\n  const lower = `${subject}\\n${text}`.toLowerCase();\n  let category = 'other';\n  if (/(job|application|interview|recruit|position|role)/.test(lower)) category = 'job_application';\n  else if (/(order|shipment|delivery|invoice|receipt)/.test(lower)) category = 'online_order';\n\n  return { json: { from, subject, text: text.slice(0, 4000), category } };\n});"
            },
